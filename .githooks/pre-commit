#!/usr/bin/env bash
set -euo pipefail

CLANG_FORMAT_BIN="${CLANG_FORMAT:-clang-format}"

if ! command -v "${CLANG_FORMAT_BIN}" >/dev/null 2>&1; then
    echo "pre-commit: clang-format not found. Install clang-format or set CLANG_FORMAT=/path/to/clang-format." >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

files=()
while IFS= read -r -d '' path; do
    files+=("${path}")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hh' '*.hpp' '*.hxx' '*.ipp' '*.ixx')

if (( ${#files[@]} == 0 )); then
    exit 0
fi

dirty_files=()
for path in "${files[@]}"; do
    if ! git diff --quiet -- "${path}"; then
        dirty_files+=("${path}")
    fi
done

if (( ${#dirty_files[@]} != 0 )); then
    echo "pre-commit: refusing to format staged files that also have unstaged edits:" >&2
    printf '  %s\n' "${dirty_files[@]}" >&2
    echo "pre-commit: stage, stash, or discard those unstaged edits before committing." >&2
    exit 1
fi

"${CLANG_FORMAT_BIN}" -i -- "${files[@]}"
git add -- "${files[@]}"
